(library
 (name workgraph_tests)
 (modules
  domain_test
  registry_test
  protocol_test
  export_test
  storage_test
  discussion_test
  api_codec_test)
 (libraries workgraph core eio_main expect_test_helpers_core)
 (inline_tests
  (deps
   (glob_files fixtures/*)))
 (preprocess
  (pps ppx_jane ppx_expect)))

(rule
 (alias runtest)
 (deps
  ../tools/check_skill.py
  ../skills/workgraph/SKILL.md
  (source_tree ../skills/workgraph))
 (action
  (run
   python3
   %{dep:../tools/check_skill.py}
   ..
   --binary
   %{exe:../bin/main.exe})))

