  "eio_main" {= "1.3"}
  "cohttp" {= "6.3.0"}
  "cohttp-eio" {= "6.3.0"}
  "http" {= "6.3.0"}
  "ppx_jane" {= "v0.17.0"}
  "ppx_expect" {= "v0.17.2"}
  "expect_test_helpers_core" {= "v0.17.0"}
  "odoc" {with-doc}
]
dev-repo: "git+https://github.com/dakotamurphyucf/workgraph.git"
x-maintenance-intent: ["(latest)"]
# The generated dependency metadata lives in dune-project. This build deliberately
# uses the current opam environment directly; it never selects a developer switch.
maintainer: ["Dakota Murphy"]
build: [
  ["./dev-ui" "package"]
  ["./dev-ui" "package-test"] {with-test}
]
