{
  "name": "@workgraph/ui",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --config ./prettier.config.js --write src tests *.json *.ts *.js index.html README.md ../tools/*.mjs ../tools/toolchain.json ../tools/*.mts ../test-support/*.mjs ../test-support/*.mts",
    "format:check": "prettier --config ./prettier.config.js --check src tests *.json *.ts *.js index.html README.md ../tools/*.mjs ../tools/toolchain.json ../tools/*.mts ../test-support/*.mjs ../test-support/*.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "build": "vite build",
    "assets": "node ../tools/embed-assets.mjs",
    "assets:check": "node ../tools/embed-assets.mjs --check",
    "licenses": "node ../tools/frontend-notices.mjs"
  },
  "dependencies": {
    "entities": "9.0.0",
    "highlight.js": "11.11.1",
    "jsonc-parser": "3.3.1",
    "lowlight": "3.3.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.17.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "parse5": "8.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
